<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:layout_marginHorizontal="@dimen/space_screen"
    android:layout_marginTop="@dimen/space_block"
    android:background="@drawable/grad_accent_round_24"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvToday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvTrainingName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Push workout"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="22sp"
        app:layout_constraintTop_toBottomOf="@id/tvToday"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="6dp"/>

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6 exercises · 45 min"
        android:textColor="@color/text_primary"
        android:alpha="0.8"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvTrainingName"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="6dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
