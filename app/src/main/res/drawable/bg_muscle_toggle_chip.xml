<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/trainingStatusSurface" />
            <stroke
                android:width="1dp"
                android:color="@color/trainingStatus" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/trainingSurfaceRaised" />
            <stroke
                android:width="1dp"
                android:color="@color/trainingOutline" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
